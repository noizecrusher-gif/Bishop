# Maintainer: noizecrusher-gif <noizecrushermusic@gmail.com>
# Generated by the release workflow from packaging/aur/PKGBUILD.in.
pkgname=bishop-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc="Terminal with a built-in AI assistant that sees what you see and types where you type"
arch=('x86_64' 'aarch64')
url="https://github.com/noizecrusher-gif/Bishop"
license=('MIT')
depends=('gtk4' 'libadwaita' 'vte4' 'glibc' 'gcc-libs')
optdepends=('polkit: force-stop root-owned processes after an Emergency Stop'
            'zsh: shell integration also supports zsh'
            'fish: shell integration also supports fish')
provides=('bishop')
conflicts=('bishop')
source_x86_64=("$url/releases/download/v$pkgver/bishop-$pkgver-x86_64-linux.tar.gz")
source_aarch64=("$url/releases/download/v$pkgver/bishop-$pkgver-aarch64-linux.tar.gz")
sha256sums_x86_64=('@SHA256_X86_64@')
sha256sums_aarch64=('@SHA256_AARCH64@')

package() {
    cd "bishop-$pkgver-$CARCH-linux"
    install -Dm755 bin/bishop "$pkgdir/usr/bin/bishop"
    cp -r share "$pkgdir/usr/"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
